.env
.env.*
*.env
!.env.example
!**/.env.example
.runtime/
data/turing.db*
# Written by init.sh after it seeds team/. Committed, it would stop every
# fresh clone from being seeded.
data/team-seeded
sandbox/*
!sandbox/.gitkeep
skills/*
!skills/.gitkeep
# The vault is personal prose by design — persona.md and profile.md are about
# the user, beliefs/ is what Turing has been told, inbox/ holds proposals they
# never accepted. Only the empty directory is tracked.
memory/*
!memory/.gitkeep
# Specialist profiles are the user's to write; init.sh seeds the defaults from
# scripts/team-templates. Only the empty directory is tracked.
team/*
!team/.gitkeep
mcp/*
!mcp/.gitkeep
!mcp/mcp.json.example
node_modules/
dist/
coverage/
*.log
