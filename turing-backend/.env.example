TURING_CLIENT_API_KEY=
# Separate least-privilege internal identities: the runtime (agent-runtime-go)
# may claim jobs and read session history; the approval consumer (mcp-files)
# may only consume approvals. Keep these different — a shared value would let
# a compromised approval consumer present the runtime's own credential.
TURING_RUNTIME_TOKEN=
TURING_APPROVAL_CONSUMER_TOKEN=
TURING_MCP_FILES_CLEANUP_TOKEN=
MCP_SYSTEM_TOKEN_GENERAL=
MCP_FILES_TOKEN_GENERAL=
TURING_APPROVAL_JWT_SECRET=
# Signs one-time remote-egress disclosure challenges. This key stays in the
# orchestrator only; it is never sent to Flutter, runtimes, or stored in SQLite.
TURING_EGRESS_SIGNING_SECRET=
# Authenticates opaque session-list cursors. Orchestrator only; 32 random bytes
# encoded as 64 lowercase hexadecimal characters. Rotation expires old cursors.
TURING_CURSOR_HMAC_SECRET=
# Seals the credentials you paste in when connecting a third-party account,
# so a copy of data/turing.db is not a copy of your app passwords. 32 bytes,
# hex-encoded: openssl rand -hex 32. Leave it empty and connecting an account
# is refused rather than storing the credential in the clear. Lose it and the
# stored credentials become unreadable — reconnect the accounts.
TURING_INTEGRATION_KEY=
ORCHESTRATOR_GRPC_ADDR=turing-orchestrator:3001
# The port the app connects to on this machine. It is published on 127.0.0.1
# only, and must differ from ORCHESTRATOR_INTERNAL_PORT.
ORCHESTRATOR_PUBLIC_PORT=3000
ORCHESTRATOR_INTERNAL_PORT=3001
DATABASE_PATH=/app/data/turing.db
MCP_CONFIG_ROOT=/mcp
FILES_SANDBOX_ROOT=/sandbox
# The host directory the memory vault is bind-mounted from, as an absolute path
# on this machine. It is display only: the orchestrator opens the vault at
# MEMORY_ROOT (/memory inside the container), and this is the folder name the
# client shows you so you can open it in Obsidian.
#
# scripts/init.sh fills it in and keeps it current, so leave it empty here.
MEMORY_DISPLAY_ROOT=
HOST_UID=
HOST_GID=
MCP_SYSTEM_BASE_URL=http://turing-mcp-system:7100/mcp
MCP_FILES_BASE_URL=http://turing-mcp-files:7110/mcp
# --- Local engine -----------------------------------------------------------
# The local route runs on Ollama (the default) or on any OpenAI-compatible
# server on this machine, such as ds4, llama.cpp's llama-server, LM Studio,
# Lemonade or vLLM. Either way a send needs no remote-egress consent, so the
# URL must name this machine: localhost, host.docker.internal or a loopback IP.
# From inside Docker that is host.docker.internal; on Linux the engine must
# listen on the Docker bridge address, not only on 127.0.0.1.
# The older OLLAMA_BASE_URL, OLLAMA_MODEL, OLLAMA_CONTEXT_WINDOW_TOKENS and
# OLLAMA_MAX_OUTPUT_TOKENS names still work and are logged as deprecated.

# Which engine serves the local route: ollama (the default) or openai, for any
# OpenAI-compatible server.
TURING_LOCAL_ENGINE=ollama
# Where the engine listens, as the containers reach it. For an engine on this
# machine, use host.docker.internal: inside a container, localhost and
# 127.0.0.1 are the container itself. Keep the engine's own path, such as /v1.
TURING_LOCAL_ENGINE_URL=http://host.docker.internal:11434
# The model the local engine runs, named the way that engine names it.
TURING_LOCAL_MODEL=qwen2.5:7b
# An OpenAI-compatible engine instead, for example ds4 on a large machine:
# TURING_LOCAL_ENGINE=openai
# TURING_LOCAL_ENGINE_URL=http://host.docker.internal:8000/v1
# TURING_LOCAL_MODEL=deepseek-chat
# The name the app shows for this engine. Empty means Ollama, or
# OpenAI-compatible for the openai engine.
# TURING_LOCAL_ENGINE_LABEL=ds4
# Optional, for a server that wants a bearer value (openai engine only):
# TURING_LOCAL_ENGINE_API_KEY=
# How long Ollama holds the model in memory after a reply (Ollama engine only). Its own default is
# 5m, which keeps ~5GB resident long after you have stopped talking to it.
# Accepts a duration (30s, 2m) or a whole number of seconds (-1 = forever).
# Integer spellings are canonicalized before they are placed in JSON.
# Keep it ABOVE TURING_APPROVAL_WAIT_TIMEOUT_MS, or the model unloads while you
# are deciding on an approval and the resumed answer pays a reload.
OLLAMA_KEEP_ALIVE=2m
# Prompt admission cap for the local model. On Ollama every request sends an
# explicit options.num_ctx rounded up to a stable power-of-two bucket that
# covers admitted prompt bytes plus output reserve, never above this value and
# never relying on the host default. Match the cap to a positive context size
# supported by the selected model, and for an OpenAI-compatible engine keep it
# at or below the context the server was started with.
TURING_LOCAL_CONTEXT_WINDOW_TOKENS=32768
# Tokens reserved for the answer inside the context window, subtracted before
# prompt admission so prompt plus output stay bounded (Ollama: num_predict).
TURING_LOCAL_MAX_OUTPUT_TOKENS=2048
# Where the remote model is reached. Whatever is sent there leaves this machine,
# so a send asks for your consent first.
OPENAI_BASE_URL=https://api.openai.com/v1
# The key for the remote model. Leave it empty and the remote model is off.
OPENAI_API_KEY=
# The remote model's name, as the endpoint at OPENAI_BASE_URL names it.
OPENAI_MODEL=gpt-4o-mini
# Local prompt admission limit for OpenAI-compatible models and routed external
# agents, and the exact ceiling advertised for routing. It is not sent as
# Ollama's num_ctx; match it to the smallest context window exposed by the
# configured endpoint/model.
OPENAI_CONTEXT_WINDOW_TOKENS=32768
# Sent as max_completion_tokens for o1/o3/o4 and GPT-5 families, otherwise
# max_tokens, and reserved before prompt admission.
OPENAI_MAX_OUTPUT_TOKENS=2048
# API keys for the agents configured in the client's Agents section, as a JSON
# object mapping the credential name you typed there to the key itself. The
# database stores only the name, so a copy of turing.db cannot spend your
# money and the client never receives a key.
#   TURING_AGENT_API_KEYS={"claude":"sk-ant-...","openai":"sk-..."}
# Leave empty if every conversation stays on this machine.
TURING_AGENT_API_KEYS=
# How long one run may take, in milliseconds.
TURING_JOB_TIMEOUT_MS=300000
# How often, in milliseconds, the orchestrator looks for runs and queued
# messages that are past their deadline.
TURING_JOB_REAPER_INTERVAL_MS=60000
# How long a queued message may wait, and what happens when it runs out. These
# bound WAITING only; the model, approval, lease and retry settings elsewhere in
# this file are unrelated and unchanged.
#
# NO_WORKER_TIMEOUT applies while nothing connected can run the message —
# the assistant is stopped, or the model it needs is gone. The clock starts when
# that is first noticed and is cleared as soon as something can run it again.
# MAX_WAIT is the total time in the queue, added up across requeues, and is the
# backstop for an assistant that is running but never gets to this message.
# Either may be 0 to switch that bound off; the message then waits indefinitely
# and still says why. Both are noticed on TURING_JOB_REAPER_INTERVAL_MS above --
# setting THAT to 0 turns both bounds off too, whatever they say here, because
# nothing then checks a deadline on an otherwise idle stack. With
# TURING_AGENT_TEAM_ENABLED=true neither MAX_WAIT nor the reaper interval may be 0:
# that bound is what ends a specialist's task nobody answered a consent for. Nor
# may they while such a task still waits, even with the team turned off.
TURING_QUEUE_NO_WORKER_TIMEOUT_MS=900000
# The most time a message may spend in the queue in total, in milliseconds.
# 0 switches this bound off.
TURING_QUEUE_MAX_WAIT_MS=43200000
# What happens to a message that runs out of time in the queue:
# fail (the message is reported as failed) or cancel (reported as cancelled).
# Both are final; there is no paused state to resume from.
TURING_QUEUE_TIMEOUT_POLICY=fail
# How often the orchestrator looks for an automation that has come due.
# 0 turns the scheduler off: no run is ever created without you sending a message.
TURING_AUTOMATION_TICK_MS=30000
# How many times a run is tried before it is reported as failed.
TURING_JOB_MAX_ATTEMPTS=3
TURING_MAX_CONCURRENT_RUNS_GENERAL=1
# The most tool calls one run may make.
TURING_MAX_TOOL_CALLS_PER_RUN=10
# Turns on the specialist team for Turing (experimental). With it on, an
# eligible turn is offered team.delegate, a call queues the specialist's task,
# and once every task has finished Turing answers from their results. The app
# shows each task as a card, where you also allow or decline, for that task,
# tools that would leave the machine. Profiles under team/ can be authored,
# enabled and granted either way.
TURING_AGENT_TEAM_ENABLED=false
# How many tasks one Turing turn may delegate to the team.
TURING_MAX_DELEGATIONS_PER_RUN=3
# How much of each specialist's result goes back to Turing; the rest is cut,
# visibly. TURING_MAX_DELEGATIONS_PER_RUN × (this + 1024) + 1024 must be at most
# 65536, or the orchestrator refuses to start.
TURING_DELEGATION_RESULT_MAX_BYTES=8192
# How long one model call may take, in milliseconds.
TURING_MODEL_TIMEOUT_MS=120000
# How long one tool call may take, in milliseconds.
TURING_TOOL_TIMEOUT_MS=30000
# How long an approval stays open before it expires, in milliseconds.
# Approval lifetime plus the runtime wait margin needed to observe persisted expiry.
TURING_APPROVAL_TIMEOUT_MS=65000
# How long a run waits for an approval decision, in milliseconds. It must cover
# TURING_APPROVAL_TIMEOUT_MS plus a margin.
TURING_APPROVAL_WAIT_TIMEOUT_MS=71000
# How long all of one run's tool calls may take together, in milliseconds. It
# must cover an approval and a tool call.
TURING_TOOL_TOTAL_TIMEOUT_MS=180000
