# Version control and agent/worktree state
.git
.github
.worktrees
.copilot
**/.copilot

# Local configuration, credentials, and runtime state
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.cert
**/.runtime
**/data
# "**/data" matches only a component named exactly "data", so the runtime SQLite
# backup directories beside it need explicit patterns to stay out of the build
# context shared by the orchestrator, agent-runtime, and mcp-files images.
**/data.backup-*
**/data.worktree-backup-*
**/sandbox

# Dependency caches, generated build output, and test artifacts
**/node_modules
**/.dart_tool
**/.pub-cache
**/.gradle
**/Pods
**/DerivedData
**/build
**/dist
**/coverage
**/*.log
**/*.test
**/*.prof
turing-backend/mcp-files/server
turing-backend/mcp-system/server

# Sources unused by the backend container builds
docs
turing-client

# Host metadata and editor state
**/.DS_Store
**/.idea
**/.vscode
